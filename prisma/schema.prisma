datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String      @id @default(cuid())
  username               String      @unique
  password               String
  deviceId               String?
  isDeviceBindingEnabled Boolean     @default(true)
  role                   String      @default("booker")
  status                 String      @default("pending") // 'pending' | 'active' | 'blocked'
  agencyName             String?
  bookerName             String?
  mobileNumber           String?
  sheetImportLimit       Int         @default(1)
  dailyImportCount       Int         @default(0)
  lastImportDate         DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model ProductSKU {
  id          String   @id @default(cuid())
  skuCode     String   @unique
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
